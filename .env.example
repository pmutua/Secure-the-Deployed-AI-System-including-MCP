# Copy to .env in the repo root and fill with real values. Never commit .env.
# (Deliverable 1 proves this: encryption/check_gitignore.py, encryption/secrets_not_in_git.sh)

# --- Auth / boot (Deliverable 1) ---
# HS256 signing secret for JWTs. The app refuses to boot without this --
# see encryption/resolve_secrets.py and encryption/boot_guard.py.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-secret-please-change-me-32chars!

# --- Kenya DPA rights lookup (Deliverable 4) ---
# A separate pepper for hashing data-subject identifiers in rights_lookup.py.
# Falls back to JWT_SECRET if unset -- see dpa/rights_lookup.py.
SUBJECT_PEPPER=

# --- At-rest demo key (Deliverable 1) ---
# Fernet key for encryption/encrypt_at_rest.py's local at-rest sketch.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCAL_FERNET_KEY=

# --- Agent / model (not re-tested this week; retrain nothing, per the brief) ---
# Set one if you want the live Week 6-8 agent path. Everything in this
# week's own deliverables runs with these unset.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=gpt-4o-mini
